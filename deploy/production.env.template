# PLANTILLA SIN SECRETOS. Los valores reales se entregan por canal privado (Key Vault/secretos de la plataforma
# o variables del shell); nunca en el repositorio, imagen, logs ni prompts. Documentado en docs/T11A_EMPAQUETADO.md.
APP_ENV=production
APP_TIMEZONE=America/Lima
MONGODB_URI=<URI de Atlas con usuario de aplicacion minimo (readWrite sobre UNA base)>
MONGODB_DATABASE=<base de publicacion, p. ej. demand_forecasting_pub; nunca demand_forecasting_v2/_dev>
AUTH_SECRET=<aleatorio >= 32 caracteres, generado al desplegar>
ALLOWED_ORIGINS=https://<fqdn publico exacto, sin barra final>
TRUSTED_PROXIES=<IP/CIDR del salto de proxy; vacio = no confiar en X-Forwarded-For>
DF_UPLOADS_DIR=/data/uploads
