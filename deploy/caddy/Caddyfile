# Proxy inverso de ENSAYO LOCAL. En Azure lo sustituye el ingress de la plataforma (docs/T11_PLAN_DESPLIEGUE.md).
{
	admin off
	auto_https disable_redirects
}

https://localhost:8443 {
	tls internal
	request_body {
		max_size 27MB
	}
	reverse_proxy api:8000 {
		# sobrescribe (no anade): el cliente no puede inyectar su propia cadena X-Forwarded-For
		header_up X-Forwarded-For {remote_host}
		header_up -Forwarded
	}
}
